# Long unique password; quote values containing $ or #.
APP_PASSWORD=
# Required hostname, without scheme/path/port. Configure DNS/LAN resolution first.
DOMAIN=
# HTTPS listening port. Existing PORT is accepted as fallback to preserve custom ports.
HTTPS_PORT=443
HTTP_PORT=80
# For LAN-only names select ./Caddyfile.internal and trust its root certificate.
CADDY_CONFIG=./Caddyfile
# Encryption is OFF unless compose.encrypted.yaml / update.sh --encrypted is used.
# DATA_KEY_FILE=/absolute/path/outside/repo/data.key
# ENCRYPTED_DATA_DIR=/absolute/path/to/migrated/encrypted-databases
