# Choose a long, unique password. Values containing $ or # should be single-quoted.
APP_PASSWORD=
PORT=8080
# Bind to 127.0.0.1 if using a reverse proxy outside this Compose project.
BIND_ADDRESS=0.0.0.0
# Optional for LAN; required for an external HTTPS reverse proxy (origin only).
PUBLIC_URL=
# Only for compose.https.yaml: domain pointing at your server, without https://.
DOMAIN=
